# Local full stack (e2e/stack): the app against the harness's mock
# issuer on 127.0.0.1:8481 (the default FC_STACK_PORT_BASE), with the e2e-only
# handles the Playwright suite drives. Never used for a deployable build.
VITE_OIDC_ORIGIN=http://127.0.0.1:8481
VITE_E2E_HOOKS=true
VITE_API_URL=http://localhost:8480/api
