VITE_API_URL=http://localhost:5080/api
VITE_IMAGE_MANAGER_URL=http://localhost:8000
# e2e-only: lets the overlay/smoke suites flip on dev fixture mode via
# localStorage against a real `vite preview` build. Never set in .env.production.
VITE_ALLOW_FIXTURE_OVERRIDE=true
# Build identity shown in Settings and index.html; CI and the image build override it.
VITE_BUILD_ID=dev
# Tests draw only the committed synthetic fixture art (src/dev-fixtures/synthetic),
# never the git-ignored real cut-outs, so results match CI on any checkout.
VITE_FIXTURE_ART=synthetic
